# ════════════════════════════════════════════════════════════════════════
# PS TELECOM — CLOUD SECRETS TEMPLATE
# Copy this file to `.env` and fill the real values:
#     cp .env.example .env
# `.env` is GIT-IGNORED — real keys never enter the repository.
# Vercel: add the same keys in Project → Settings → Environment Variables,
# then redeploy (NEXT_PUBLIC_* values are baked at build time).
# ════════════════════════════════════════════════════════════════════════

# ── Cloudflare D1 — SERVER-SIDE (used by /api/cloud/d1 proxy route) ──────
# Where to find them (Cloudflare dashboard):
#   Account ID  → dash.cloudflare.com → any domain/Workers page (right side)
#   Database ID → Storage & Databases → D1 SQL Database → your database
#   API Token   → My Profile → API Tokens (create with "D1 Edit" permission,
#                 scoped to THIS database only)
CLOUDFLARE_ACCOUNT_ID=PASTE_YOUR_ACCOUNT_ID
CLOUDFLARE_D1_DATABASE_ID=PASTE_YOUR_DATABASE_ID
CLOUDFLARE_D1_API_TOKEN=PASTE_YOUR_D1_API_TOKEN

# ── Cloudflare D1 — CLIENT BUILD (baked into the APK; web relays) ────────
# Same three values as above. Required for the APK build (the device calls
# api.cloudflare.com directly — no server inside the app). Web builds can
# omit them: the browser relays through /api/cloud/d1 which uses the
# server-side CLOUDFLARE_* values above.
NEXT_PUBLIC_CF_ACCOUNT_ID=PASTE_YOUR_ACCOUNT_ID
NEXT_PUBLIC_CF_DATABASE_ID=PASTE_YOUR_DATABASE_ID
NEXT_PUBLIC_CF_API_TOKEN=PASTE_YOUR_D1_API_TOKEN

# ── Default sync account — auto-connect, NO sign-in UI (v2.19.0) ─────────
# The app signs itself into this sync account at boot (join → create).
# SYNC PIN must be the SAME PIN the shop devices already use — it derives
# the AES-256-GCM payload encryption key. A wrong PIN → sync stays off
# with a calm "wrong-pin" status. Minimum 4 chars (6+ recommended).
NEXT_PUBLIC_SYNC_ID=PASTE_YOUR_SYNC_ID
NEXT_PUBLIC_SYNC_PIN=PASTE_YOUR_SYNC_PIN
