rules_version = '2';

// PS TELECOM — Cloud Backup rules.
//
// The app stores its backup mirror under psStock/{userId}/{store}/{recordId}.
// There is no Firebase Auth in the app yet, so the psStock tree is open
// (same trust level as the public web config). When Auth is added later,
// tighten this to: request.auth != null && request.auth.uid == userId.
service cloud.firestore {
  match /databases/{database}/documents {
    match /psStock/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Everything outside psStock stays denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
